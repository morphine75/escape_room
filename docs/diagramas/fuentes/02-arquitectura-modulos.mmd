    SES["session.js<br/>localStorage"]
    UI["ui.js<br/>pantallas · toasts · vibración"]
    FBJS["firebase.js<br/>init SDK"]
    CFG["firebase-config.js"]
  end

  subgraph Niveles["Niveles"]
    direction LR
    L1["level1/level1.js<br/>motor tiempo real"]
    GEN["level1/generator.js<br/>laberinto + BFS"]
    SER["level2/serif.js<br/>I Shot The Serif"]
    VEC["level2/vector.js<br/>Shape Type"]
    RAIN["digitalrain.js<br/>lluvia Matrix"]
  end

  SDK["☁️ Firebase SDK (gstatic CDN)"]

  APP --> ROOM & SYNC & SES & UI & FBJS
  APP --> L1 & SER & VEC & RAIN
  DASH --> ROOM & SYNC & SES & UI & FBJS
  L1 --> GEN & UI
  SER --> UI
  VEC --> UI
  ROOM --> FBJS & SES
  SYNC --> FBJS
  ROOM & SYNC & DASH --> SDK
  FBJS --> CFG & SDK

